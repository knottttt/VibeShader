CCEffect %{
  techniques:
  - name: transparent
    passes:
    - vert: sprite-vs:vert
      frag: sprite-fs:frag
      depthStencilState: { depthTest: false, depthWrite: false }
      blendState: { targets: [{ blend: true, blendSrc: src_alpha, blendDst: one_minus_src_alpha, blendSrcAlpha: src_alpha, blendDstAlpha: one_minus_src_alpha }] }
      rasterizerState: { cullMode: none }
      properties:
        samplingWidthN: { value: 2 }
        samplingDirectionN: { value: [1, 0] }
        intensityN: { value: 1 }
        textureSizeN: { value: [256, 256] }
        uvMinN: { value: [0, 0] }
        uvMaxN: { value: [1, 1] }
        alphaThreshold: { value: 0.001 }
}%
CCProgram sprite-vs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>
  #if USE_LOCAL
    #include <builtin/uniforms/cc-local>
  #endif
  #if SAMPLE_FROM_RT
    #include <common/common-define>
  #endif
  in vec3 a_position; in vec2 a_texCoord; in vec4 a_color; out vec2 uv0; out vec4 color;
  vec4 vert () {
    vec4 p=vec4(a_position,1.0);
    #if USE_LOCAL
      p=cc_matWorld*p;
    #endif
    p=cc_matViewProj*p; uv0=a_texCoord; color=a_color;
    #if SAMPLE_FROM_RT
      CC_HANDLE_RT_SAMPLE_FLIP(uv0);
    #endif
    return p;
  }
}%
CCProgram sprite-fs %{
  precision highp float;
  #include <builtin/internal/embedded-alpha>
  #include <builtin/internal/alpha-test>
  in vec2 uv0; in vec4 color;
  #pragma builtin(local)
  layout(set=2,binding=12) uniform sampler2D cc_spriteTexture;
  uniform Constant { vec2 samplingDirectionN; vec2 textureSizeN; vec2 uvMinN; vec2 uvMaxN; float samplingWidthN; float intensityN; };
  vec4 frag () { vec2 dir=normalize(samplingDirectionN+vec2(0.00001)); vec2 offset=dir*samplingWidthN/max(textureSizeN,vec2(1.0)); vec4 base=CCSampleWithAlphaSeparated(cc_spriteTexture,uv0); vec4 left=CCSampleWithAlphaSeparated(cc_spriteTexture,clamp(uv0-offset,uvMinN,uvMaxN)); vec4 right=CCSampleWithAlphaSeparated(cc_spriteTexture,clamp(uv0+offset,uvMinN,uvMaxN)); vec3 shifted=vec3(left.r,base.g,right.b); vec4 o=vec4(mix(base.rgb,shifted,clamp(intensityN,0.0,1.0)),base.a)*color; ALPHA_TEST(o); return o; }
}%
