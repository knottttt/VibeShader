CCEffect %{
  techniques:
  - name: transparent
    passes:
    - vert: sprite-vs:vert
      frag: sprite-fs:frag
      depthStencilState: { depthTest: false, depthWrite: false }
      blendState:
        targets:
        - blend: true
          blendSrc: src_alpha
          blendDst: one_minus_src_alpha
          blendSrcAlpha: src_alpha
          blendDstAlpha: one_minus_src_alpha
      rasterizerState: { cullMode: none }
      properties:
        detailTexture: { value: white }
        detailModeN: { value: 0 }
        hasDetailTextureN: { value: 0 }
        intensityN: { value: 1 }
        spriteSizeN: { value: [100, 100] }
        spriteAnchorN: { value: [0.5, 0.5] }
        alphaThreshold: { value: 0.001 }
}%
CCProgram sprite-vs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>
  #if USE_LOCAL
    #include <builtin/uniforms/cc-local>
  #endif
  #if SAMPLE_FROM_RT
    #include <common/common-define>
  #endif
  in vec3 a_position; in vec2 a_texCoord; in vec4 a_color;
  out vec2 uv0; out vec2 localPos0; out vec4 color;
  vec4 vert () {
    vec4 p = vec4(a_position, 1.0);
    #if USE_LOCAL
      p = cc_matWorld * p;
    #endif
    p = cc_matViewProj * p;
    uv0 = a_texCoord;
    localPos0 = a_position.xy;
    color = a_color;
    #if SAMPLE_FROM_RT
      CC_HANDLE_RT_SAMPLE_FLIP(uv0);
    #endif
    return p;
  }
}%
CCProgram sprite-fs %{
  precision highp float;
  #include <builtin/internal/embedded-alpha>
  #include <builtin/internal/alpha-test>
  in vec2 uv0; in vec2 localPos0; in vec4 color;
  #pragma builtin(local)
  layout(set = 2, binding = 12) uniform sampler2D cc_spriteTexture;
  uniform sampler2D detailTexture;
  uniform Constant { vec2 spriteSizeN; vec2 spriteAnchorN; float detailModeN; float hasDetailTextureN; float intensityN; float paddingN; };
  vec4 frag () {
    vec4 o = CCSampleWithAlphaSeparated(cc_spriteTexture, uv0) * color;
    if (hasDetailTextureN < 0.5) { ALPHA_TEST(o); return o; }
    vec2 localUv = localPos0 / max(spriteSizeN, vec2(0.0001)) + spriteAnchorN;
    vec4 detail = texture(detailTexture, localUv);
    float amount = clamp(intensityN, 0.0, 1.0);
    if (detailModeN < 0.5) o.a *= mix(1.0, detail.a, amount);
    else if (detailModeN < 1.5) o.rgb = mix(o.rgb, o.rgb * detail.rgb, amount);
    else if (detailModeN < 2.5) o.rgb += detail.rgb * detail.a * amount;
    else o.rgb = mix(o.rgb, detail.rgb, detail.a * amount);
    ALPHA_TEST(o); return o;
  }
}%
