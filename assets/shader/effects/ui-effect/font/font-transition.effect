CCEffect %{
  techniques:
  - name: transparent
    passes:
    - vert: sprite-vs:vert
      frag: sprite-fs:frag
      depthStencilState: { depthTest: false, depthWrite: false }
      blendState:
        targets:
        - blend: true
          blendSrc: src_alpha
          blendDst: one_minus_src_alpha
          blendSrcAlpha: src_alpha
          blendDstAlpha: one_minus_src_alpha
      rasterizerState: { cullMode: none }
      properties:
        transitionTexture: { value: white }
        transitionColor: { value: [1, 1, 1, 1], editor: { type: color } }
        transitionModeN: { value: 0 }
        transitionRateN: { value: 0 }
        transitionWidthN: { value: 0.1 }
        transitionSoftnessN: { value: 0.02 }
        hasTransitionTextureN: { value: 0 }
        intensityN: { value: 1 }
        spriteSizeN: { value: [100, 100] }
        spriteAnchorN: { value: [0.5, 0.5] }
        alphaThreshold: { value: 0.001 }
}%
CCProgram sprite-vs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>
  #if USE_LOCAL
    #include <builtin/uniforms/cc-local>
  #endif
  #if SAMPLE_FROM_RT
    #include <common/common-define>
  #endif
  in vec3 a_position; in vec2 a_texCoord; in vec4 a_color;
  out vec2 uv0; out vec2 localPos0; out vec4 color;
  vec4 vert () {
    vec4 pos = vec4(a_position, 1.0);
    #if USE_LOCAL
      pos = cc_matWorld * pos;
    #endif
    pos = cc_matViewProj * pos;
    uv0 = a_texCoord; localPos0 = a_position.xy; color = a_color;
    #if SAMPLE_FROM_RT
      CC_HANDLE_RT_SAMPLE_FLIP(uv0);
    #endif
    return pos;
  }
}%
CCProgram sprite-fs %{
  precision highp float;
  #include <builtin/internal/embedded-alpha>
  #include <builtin/internal/alpha-test>
  in vec2 uv0; in vec2 localPos0; in vec4 color;
  #if USE_TEXTURE
    #pragma builtin(local)
    layout(set = 2, binding = 12) uniform sampler2D cc_spriteTexture;
  #endif
  uniform sampler2D transitionTexture;
  uniform Constant {
    vec4 transitionColor;
    float transitionModeN;
    float transitionRateN;
    float transitionWidthN;
    float transitionSoftnessN;
    float hasTransitionTextureN;
    float intensityN;
    vec2 spriteSizeN;
    vec2 spriteAnchorN;
  };
  vec4 frag () {
    vec4 tex = vec4(1.0);
    #if USE_TEXTURE
      tex = CCSampleWithAlphaSeparated(cc_spriteTexture, uv0);
      #if IS_GRAY
        tex.rgb = vec3(dot(tex.rgb, vec3(0.2126, 0.7152, 0.0722)));
      #endif
    #endif
    vec4 o = tex * color;
    vec2 localUv = localPos0 / max(spriteSizeN, vec2(0.0001)) + spriteAnchorN;
    float maskN = hasTransitionTextureN > 0.5 ? texture(transitionTexture, localUv).a : localUv.x;
    float rateN = clamp(transitionRateN, 0.0, 1.0);
    float softN = max(transitionSoftnessN, 0.0001);
    float visibleN = smoothstep(rateN - softN, rateN + softN, maskN);
    float edgeN = 1.0 - smoothstep(0.0, max(transitionWidthN, 0.0001), abs(maskN - rateN));
    if (transitionModeN < 0.5) o.a *= 1.0 - rateN;
    else if (transitionModeN < 1.5) o.a *= visibleN;
    else if (transitionModeN < 2.5) { o.rgb = mix(o.rgb, transitionColor.rgb, edgeN * transitionColor.a * intensityN); o.a *= visibleN; }
    else if (transitionModeN < 3.5) o.a *= mix(1.0, maskN, rateN);
    else o.rgb += transitionColor.rgb * edgeN * transitionColor.a * intensityN;
    ALPHA_TEST(o); return o;
  }
}%
